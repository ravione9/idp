# =============================================================================
# LILG IdP — Dev server (single tier, Docker on 192.168.24.254)
# Copy to .env on the server:  cp env.dev.example .env
# =============================================================================

# Dev server base URL (use hostname if Google OAuth rejects raw IP — see deploy script)
PUBLIC_BASE_URL=http://192.168.24.254:8080
SAML_IDP_BASE_URL=http://192.168.24.254:8080
SAML_IDP_ENTITY_ID=http://192.168.24.254:8080/saml/metadata

# Database (Docker service name — do not change when using docker-compose.dev.yml)
DB_HOST=mysql
DB_PORT=3306
DB_USER=lilg_app
DB_PASSWORD=s3cr3t_change_me
DB_NAME=lilg

REDIS_URL=redis://redis:6379/0

AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localstack:4566
SQS_HRMS_EVENTS_URL=http://localstack:4566/000000000000/lilg-hrms-events
SQS_CELERY_BROKER_URL=http://localstack:4566/000000000000/lilg-celery

GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_HOSTED_DOMAIN=lenskart.com
GOOGLE_SA_KEY_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50In0=

# Zoho is NOT a portal login provider — Zoho Mail is consumed as a SAML
# application served by this IdP. The vars below are only for the outbound
# Zoho People SCIM provisioning adapter (optional; leave blank to disable).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_SCIM_BASE_URL=

AD_URL=ldaps://dc01.lenskart.local:636
AD_BIND_DN=CN=lilg-svc,OU=ServiceAccounts,DC=lenskart,DC=local
AD_BIND_PASSWORD=dev_ad_password
AD_BASE_DN=DC=lenskart,DC=local

HRMS_API_BASE_URL=https://lenskart.darwinbox.in/api
HRMS_API_KEY=dev_hrms_api_key

SESSION_SECRET=dev_change_this_to_a_random_64_char_hex_string_before_go_live_abc123
SESSION_TTL_CORPORATE_HOURS=8
SESSION_TTL_STORE_HOURS=12
# Plain HTTP on 192.168.24.254 — must be false or browser rejects the session cookie
COOKIE_SECURE=false

PORT=8080
NODE_ENV=production
LOG_LEVEL=debug
LILG_DETERMINISTIC=false

OUTBOX_LEADER_TTL_MS=30000
OUTBOX_POLL_INTERVAL_MS=5000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50

INTERNAL_TOKEN=dev_internal_token_change_me

# First super admin bootstrap (shown on login page when no local admins exist)
LOCAL_BOOTSTRAP_TOKEN=dev_bootstrap_token_change_me

# Master administrator — auto-created on startup; use these credentials on /login
MASTER_ADMIN_EMAIL=admin@lenskart.com
MASTER_ADMIN_PASSWORD=ChangeMe_Admin123!
MASTER_ADMIN_FULL_NAME=LILG Master Administrator

# Optional — leave empty until you generate dev SAML keys (scripts/gen-saml-dev-keys.sh)
# SAML_IDP_PRIVATE_KEY_PEM=
# SAML_IDP_CERT_PEM=
