# =============================================================================
# LILG IdP — Production behind Cloudflare WAF (proxied)
# Copy to .env on the production host:  cp env.prod.example .env
# Public URL: https://idp.lenskart.com
# =============================================================================

PUBLIC_BASE_URL=https://idp.lenskart.com
SAML_IDP_BASE_URL=https://idp.lenskart.com
SAML_IDP_ENTITY_ID=https://idp.lenskart.com/saml/metadata

# HTTPS via Cloudflare — session cookies must be Secure
COOKIE_SECURE=true

# Cloudflare orange-cloud (proxied) — trust X-Forwarded-Proto / CF-Connecting-IP
TRUST_PROXY=true

NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Database / Redis — use your production endpoints (not Docker service names unless on same compose network)
DB_HOST=mysql
DB_PORT=3306
DB_USER=lilg_app
DB_PASSWORD=CHANGE_ME
DB_NAME=lilg

REDIS_URL=redis://redis:6379/0

SESSION_SECRET=CHANGE_ME_min_64_random_chars
SESSION_TTL_CORPORATE_HOURS=8
SESSION_TTL_STORE_HOURS=12

INTERNAL_TOKEN=CHANGE_ME_min_16_chars

MASTER_ADMIN_EMAIL=admin@lenskart.com
MASTER_ADMIN_PASSWORD=CHANGE_ME
MASTER_ADMIN_FULL_NAME=LILG Master Administrator

# SAML signing keys — generate once and keep stable (SPs pin the cert fingerprint)
# SAML_IDP_PRIVATE_KEY_PEM=
# SAML_IDP_CERT_PEM=

SAML_KEY_DIR=/app/data/saml

# Google OAuth — add authorized redirect URI in Google Cloud Console:
#   https://idp.lenskart.com/auth/google/callback
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_HOSTED_DOMAIN=lenskart.com
GOOGLE_SA_KEY_JSON=REPLACE_ME

AD_URL=ldaps://dc01.lenskart.local:636
AD_BIND_DN=CN=lilg-svc,OU=ServiceAccounts,DC=lenskart,DC=local
AD_BIND_PASSWORD=CHANGE_ME
AD_BASE_DN=DC=lenskart,DC=in

HRMS_API_BASE_URL=https://lenskart.darwinbox.in/api
HRMS_API_KEY=CHANGE_ME

AWS_REGION=ap-south-1
SQS_HRMS_EVENTS_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT/lilg-hrms-events
SQS_CELERY_BROKER_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT/lilg-celery

# -----------------------------------------------------------------------------
# Cloudflare checklist (DNS / SSL / origin port)
# -----------------------------------------------------------------------------
# 1. DNS A record: idp.lenskart.com → cloud server public IP, Proxied ON (orange cloud)
# 2. SSL/TLS encryption mode: Flexible
#    (Browser→CF HTTPS, CF→origin HTTP on port 80 — matches docker-compose.prod.yml)
# 3. Origin MUST listen on port 80 — deploy with: bash scripts/deploy-prod.sh
#    (maps host :80 → container :8080)
# 4. Cloud/server firewall: allow inbound TCP 80 (and 443 only if you terminate TLS on origin)
# 5. WAF: do not block /healthz, /login, /auth/*, /api/*, /saml/* (503/403 often = WAF or dead origin)
# 6. Google OAuth redirect: https://idp.lenskart.com/auth/google/callback
