# =============================================================================
# LILG — Lenskart Identity Lifecycle & Governance
# Environment Variables Reference
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (MySQL 8)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lilg_app
DB_PASSWORD=s3cr3t_change_me
DB_NAME=lilg

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# AWS
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1
# SQS queue URL that receives HRMS lifecycle events (e.g. from Darwinbox webhooks)
SQS_HRMS_EVENTS_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/lilg-hrms-events
# SQS queue used as Celery broker for Python worker tasks
SQS_CELERY_BROKER_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/lilg-celery

# -----------------------------------------------------------------------------
# GOOGLE WORKSPACE (OIDC + Directory API)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# Restrict logins to this hosted domain
GOOGLE_HOSTED_DOMAIN=lenskart.com
# Base64-encoded JSON of the Google Service Account key (domain-wide delegation)
GOOGLE_SA_KEY_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwicHJvamVjdF9pZCI6ImxlbnNrYXJ0LWlhbSJ9

# -----------------------------------------------------------------------------
# ZOHO (outbound provisioning only — NOT a portal sign-in provider)
#
# Zoho Mail is consumed as a SAML application (this IdP issues assertions to
# zoho.com). Leave the values below blank to disable the outbound Zoho
# People SCIM provisioning adapter — keep them populated only if you want
# this IdP to push user data into Zoho People.
# -----------------------------------------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_SCIM_BASE_URL=

# -----------------------------------------------------------------------------
# ACTIVE DIRECTORY / LDAP
# -----------------------------------------------------------------------------
AD_URL=ldaps://dc01.lenskart.local:636
AD_BIND_DN=CN=lilg-svc,OU=ServiceAccounts,DC=lenskart,DC=local
AD_BIND_PASSWORD=Adm!nS3cr3t_change_me
AD_BASE_DN=DC=lenskart,DC=local

# -----------------------------------------------------------------------------
# HRMS (Darwinbox REST API)
# -----------------------------------------------------------------------------
HRMS_API_BASE_URL=https://lenskart.darwinbox.in/api
HRMS_API_KEY=dbox_apikey_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# SESSION
# -----------------------------------------------------------------------------
SESSION_SECRET=super_long_random_hex_string_at_least_64_chars_change_me_now_please
# Session TTL in hours for corporate employees (local password / Google OIDC)
SESSION_TTL_CORPORATE_HOURS=8
# Session TTL in hours for store/retail staff (OTP/biometric)
SESSION_TTL_STORE_HOURS=12

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
PORT=8080
NODE_ENV=production
LOG_LEVEL=info
# When true, the FSM will compute all transitions synchronously (useful for CI)
LILG_DETERMINISTIC=false

# -----------------------------------------------------------------------------
# OUTBOX WORKER
# -----------------------------------------------------------------------------
# How long (ms) the outbox leader lock stays alive before a peer can steal it
OUTBOX_LEADER_TTL_MS=30000
# How often (ms) the worker drains the outbox batch
OUTBOX_POLL_INTERVAL_MS=5000

# -----------------------------------------------------------------------------
# CIRCUIT BREAKER
# -----------------------------------------------------------------------------
# Percentage of errors (0-100) that opens the circuit for an adapter
CIRCUIT_BREAKER_ERROR_THRESHOLD=50

# -----------------------------------------------------------------------------
# INTERNAL API TOKEN (shared secret for Airflow → LILG internal routes)
# -----------------------------------------------------------------------------
INTERNAL_TOKEN=internal_shared_secret_change_me_please

# One-time token to create first SUPER_ADMIN on login page (disable after bootstrap)
LOCAL_BOOTSTRAP_TOKEN=change_me_bootstrap_token_min_16_chars

# Override session cookie Secure flag — set false ONLY for plain-HTTP dev environments
# (defaults to true when NODE_ENV=production)
# COOKIE_SECURE=true

# Master administrator — provisioned on every startup (change before production)
MASTER_ADMIN_EMAIL=admin@lenskart.com
MASTER_ADMIN_PASSWORD=ChangeMe_Admin123!
MASTER_ADMIN_FULL_NAME=LILG Master Administrator

# -----------------------------------------------------------------------------
# Public hostname — idp.lenskart.com (portal + SAML IdP + OIDC login)
# -----------------------------------------------------------------------------
PUBLIC_BASE_URL=https://idp.lenskart.com

# -----------------------------------------------------------------------------
# SAML 2.0 IdP (enterprise application SSO for all users)
# Register each app via POST /api/internal/saml with X-Internal-Token.
# IdP metadata (give to every SAML app admin): https://idp.lenskart.com/saml/metadata
# Google OAuth redirect URI: https://idp.lenskart.com/auth/google/callback
# Zoho OAuth redirect URI:   https://idp.lenskart.com/auth/zoho/callback
# -----------------------------------------------------------------------------
SAML_IDP_BASE_URL=https://idp.lenskart.com
SAML_IDP_ENTITY_ID=https://idp.lenskart.com/saml/metadata
# PEM private key and cert (use \n for newlines in .env, or multiline in secrets manager)
SAML_IDP_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
SAML_IDP_CERT_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
