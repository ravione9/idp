# Vault KV v1 path: multiverse/config/idp
# Role: idp  |  SA: idp-sa  |  Namespace: it-idp
#
# Fill real values, then write into Vault (UI or CLI). Do NOT commit filled file.
# Vault Agent must export these into process env (source /vault/secrets/idp.env).
#
# SAML PEMs: from .saml-idp-keys/ or bash scripts/generate-saml-idp-keys.sh
# Store PEM as a single line with literal \n between lines (app expands them).

# --- Required for boot ---
DB_USER=admin
DB_PASSWORD=CHANGE_ME_RDS_PASSWORD

# Must be redis:// or rediss:// — URL-encode special chars in password (@ # / : etc.)
# Example: rediss://:My%40Pass@idp-redis-cluster-001.idp-redis-cluster.gbr4zh.aps1.cache.amazonaws.com:6379/0
REDIS_URL=rediss://:CHANGE_ME_REDIS_PASSWORD@idp-redis-cluster-001.idp-redis-cluster.gbr4zh.aps1.cache.amazonaws.com:6379/0

SESSION_SECRET=CHANGE_ME_openssl_rand_base64_48
INTERNAL_TOKEN=CHANGE_ME_openssl_rand_hex_32

MASTER_ADMIN_EMAIL=CHANGE_ME_admin@lenskart.com
MASTER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MASTER_ADMIN_FULL_NAME=LILG Master Administrator

SAML_IDP_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----
SAML_IDP_CERT_PEM=-----BEGIN CERTIFICATE-----\nCHANGE_ME\n-----END CERTIFICATE-----

# --- Optional: omit when configured via portal (Settings / Connectors) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_HOSTED_DOMAIN=
# GOOGLE_SA_KEY_JSON=
# AD_URL=
# AD_BIND_DN=
# AD_BIND_PASSWORD=
# AD_BASE_DN=
# HRMS_API_BASE_URL=
# HRMS_API_KEY=

# SMTP / Zoho SCIM — optional
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@lenskart.com
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_SCIM_BASE_URL=
