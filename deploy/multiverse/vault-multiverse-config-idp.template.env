# Vault KV v1 path: multiverse/config/idp
# Role: idp  |  SA: idp-sa  |  Namespace: it-idp
#
# Fill real values, then write into Vault (UI or CLI). Do NOT commit filled file.
# Vault Agent Injector must export these as process environment variables.
#
# SAML PEMs: run  bash scripts/generate-saml-idp-keys.sh
#   (or load from .saml-idp-keys/ after local generation — gitignored)

DB_USER=admin
DB_PASSWORD=CHANGE_ME_RDS_PASSWORD

# TLS on, cluster mode disabled — primary node endpoint
REDIS_URL=rediss://:CHANGE_ME_REDIS_PASSWORD@idp-redis-cluster-001.idp-redis-cluster.gbr4zh.aps1.cache.amazonaws.com:6379/0

SESSION_SECRET=CHANGE_ME_openssl_rand_base64_48
INTERNAL_TOKEN=CHANGE_ME_openssl_rand_hex_32

MASTER_ADMIN_EMAIL=CHANGE_ME_admin@lenskart.com
MASTER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MASTER_ADMIN_FULL_NAME=LILG Master Administrator

# Paste full PEM including BEGIN/END lines (Vault Agent must preserve newlines)
SAML_IDP_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----
SAML_IDP_CERT_PEM=-----BEGIN CERTIFICATE-----\nCHANGE_ME\n-----END CERTIFICATE-----

GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_HOSTED_DOMAIN=lenskart.com,lenskart.in,dealskart.in
GOOGLE_SA_KEY_JSON=CHANGE_ME_BASE64_SA_KEY

AD_URL=ldaps://CHANGE_ME:636
AD_BIND_DN=CHANGE_ME
AD_BIND_PASSWORD=CHANGE_ME
AD_BASE_DN=CHANGE_ME

HRMS_API_BASE_URL=https://CHANGE_ME
HRMS_API_KEY=CHANGE_ME

# Optional — leave empty / omit if unused
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@lenskart.com
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_SCIM_BASE_URL=
