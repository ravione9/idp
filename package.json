    "@types/nodemailer": "^6.4.24",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2-sftp-client": "^9.0.6",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "ts-jest": "^29.4.12",
