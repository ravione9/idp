    "@aws-sdk/client-sqs": "^3.600.0",
    "@simplewebauthn/server": "^13.3.2",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^140.0.0",
    "ioredis": "^5.4.1",
    "jose": "^5.4.0",
    "ldapts": "^9.0.0",
    "mysql2": "^3.10.1",
